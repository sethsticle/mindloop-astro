---

<div class="footer-v2-host border-border/20 relative z-[12] overflow-hidden border-t">
  <!-- Background image -->
  <div
    class="absolute inset-0 h-full w-full"
    style="
      background-image: url('/assets/images/footer-bg.webp');
      background-size: cover;
      background-position: center top;
    "
    aria-hidden="true">
  </div>

  <!-- Top fade: bleed from page background into the image -->
  <div class="from-background pointer-events-none absolute inset-x-0 top-0 z-20 h-40 bg-gradient-to-b to-transparent" aria-hidden="true"></div>

  <!-- Left / right edge softening -->
  <div class="from-background/60 pointer-events-none absolute inset-y-0 left-0 z-20 w-24 bg-gradient-to-r to-transparent" aria-hidden="true"></div>
  <div class="from-background/60 pointer-events-none absolute inset-y-0 right-0 z-20 w-24 bg-gradient-to-l to-transparent" aria-hidden="true"></div>

  <div class="relative z-30 px-4 pt-24 pb-56 md:px-8 md:pb-72">
    <!-- Glass footer card -->
    <footer class="liquid-glass animate-footer-in mx-auto w-full max-w-6xl rounded-3xl p-6 text-white/70 md:p-10">
      <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
        <!-- Brand block -->
        <div class="md:col-span-5">
          <a href="/" class="group mb-4 flex items-center gap-2.5 text-white">
            <!-- <Logo className="h-10 w-auto "/> -->
            <LogoV2 imgClass="h-10 w-auto" />
            <!-- <span class="text-xl font-medium tracking-tight mt-2">Marketing Solutions</span> -->
          </a>
          <p class="max-w-sm text-sm leading-relaxed">Helping ambitious brands break free from the ordinary and reach new heights — one mission at a time.</p>
        </div>

        <!-- Nav link groups
             Mobile: Explore left col, Platform+Company stacked in right col.
             sm+:    three equal columns via sm:contents unwrapping the inner wrapper. -->
        <div class="flex gap-8 sm:grid sm:grid-cols-3 md:col-span-7">
          <!-- Explore — always first / left column -->
          <div class="flex-1">
            <h4 class="mb-4 text-sm font-medium tracking-wider text-white uppercase">
              {navGroups[0].title}
            </h4>
            <ul class="space-y-2 text-xs">
              {
                navGroups[0].items.map((item) => (
                  <li>
                    <a href={item.href} class="transition-colors hover:text-white">
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Platform + Company: stacked in one flex column on mobile,
               unwrapped into two separate grid cells on sm+ via sm:contents -->
          <div class="flex flex-1 flex-col gap-8 sm:contents">
            {
              navGroups.slice(1).map((group) => (
                <div>
                  <h4 class="mb-4 text-sm font-medium tracking-wider text-white uppercase">{group.title}</h4>
                  <ul class="space-y-2 text-xs">
                    {group.items.map((item) => (
                      <li>
                        <a href={item.href} class="transition-colors hover:text-white">
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Bottom bar inside glass card -->
      <div class="flex flex-col items-center justify-between gap-6 border-t border-white/10 pt-6 md:flex-row md:gap-4">
        <p class="text-xs opacity-60">© {new Date().getFullYear()} MLD Marketing Solutions. All rights reserved.</p>
        <div class="flex items-center gap-4">
          <span class="text-[10px] tracking-widest uppercase opacity-50">Follow along:</span>
          <div class="flex items-center gap-4">
            {socials.map((s) => <a href={s.href} aria-label={s.label} class="opacity-70 transition-all hover:text-white hover:opacity-100" set:html={s.svg} />)}
          </div>
        </div>
      </div>
    </footer>

    <!-- Legal strip below the glass card -->
    <div class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2">
      {
        legalLinks.map((l) => (
          <a href={l.href} class="text-muted-foreground hover:text-foreground text-xs transition-colors">
            {l.label}
          </a>
        ))
      }
    </div>
  </div>
</div>
