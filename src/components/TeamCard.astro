---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  name: string;
  phone?: string;
  phoneHref?: string;
  email1?: string;
  email2?: string;
  class?: string;
}
const {
  image,
  name,
  phone      = '071 939 7108',
  phoneHref  = 'https://wa.me/27719397108',
  email1     = 'michael@mldmarketing.co.za',
  email2     = 'sasha@mldmarketing.co.za',
  class: cls = '',
} = Astro.props;
---

