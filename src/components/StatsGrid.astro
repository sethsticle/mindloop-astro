---
// SVG constants computed at build time so the script never needs to recalculate them.
// Values are passed to the DOM via data-* attributes and read by the animation script.

const CIRC = parseFloat((2 * Math.PI * 58).toFixed(1)); // donut r=58 → 364.4

// MLD's 6 headline stats. Five are plain counts (rendered as animated counters,
// with an optional "+" suffix); the organic-growth figure is a percentage and
// gets the donut/pie treatment the client brief specifically asked for.
const counters = [
  { target: 10,    suffix: '',  label: 'Years in Orbit',           sub: 'Helping brands navigate the digital universe since 2016.' },
  { target: 150,   suffix: '+', label: 'Missions Completed',       sub: 'Successful projects delivered across multiple industries.' },
  { target: 20,    suffix: '+', label: 'Crew Members',             sub: 'A growing team of specialists, strategists, and creatives.' },
  { target: 10000, suffix: '+', label: 'Assets Launched',          sub: 'Content, websites, campaigns, and creative projects delivered.' },
  { target: 60,    suffix: '+', label: 'Brands Growing With MLD',  sub: 'Helping businesses grow across borders and industries.' },
];
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

  <!-- Donut — Organic Growth, the client's headline stat, rendered as the pie chart the brief asked for -->
  <div class="liquid-glass rounded-2xl p-7 cursor-default select-none"
       data-card="donut" data-target="85" data-circ={CIRC}>
    <p class="text-[10px] uppercase tracking-[0.12em] text-muted-foreground mb-3">Organic Growth</p>
    <div class="flex justify-center my-1">
      <svg width="160" height="160" viewBox="0 0 160 160" style="overflow:visible" aria-hidden="true">
        <defs>
          <linearGradient id="donut-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%"   stop-color="#F69422"/>
            <stop offset="100%" stop-color="#0CA99E"/>
          </linearGradient>
        </defs>
        <!-- background ring -->
        <circle cx="80" cy="80" r="58" fill="none"
          stroke="rgba(255,255,255,0.06)" stroke-width="14"
          shape-rendering="geometricPrecision"/>
        <!-- animated ring — stroke-dashoffset driven by JS -->
        <circle data-stat="arc" cx="80" cy="80" r="58" fill="none"
          stroke="url(#donut-grad)" stroke-width="14" stroke-linecap="round"
          transform="rotate(-90 80 80)"
          stroke-dasharray={CIRC} stroke-dashoffset={CIRC}
          shape-rendering="geometricPrecision"
          style="will-change:stroke-dashoffset"/>
        <text data-stat="label" x="80" y="86" text-anchor="middle"
          font-size="28" font-weight="500" fill="rgba(255,255,255,0.9)"
          font-family="system-ui,-apple-system,sans-serif">0%</text>
      </svg>
    </div>
    <p class="text-xs text-muted-foreground">of our clients' marketing success is organic</p>
  </div>

  <!-- Counters — remaining 5 headline stats -->
  {counters.map(({ target, suffix, label, sub }) => (
    <div class="liquid-glass rounded-2xl p-7 cursor-default select-none"
         data-card="counter" data-target={target} data-suffix={suffix}>
      <p class="text-[10px] uppercase tracking-[0.12em] text-muted-foreground mb-5">{label}</p>
      <div data-stat="value"
           class="text-5xl font-medium leading-none tracking-[-0.06em] text-brand-yellow">
        0
      </div>
      <div class="h-0.5 w-full rounded-sm my-4"
           style="background:linear-gradient(90deg,#F69422 0%,transparent 100%)"></div>
      <p class="text-xs text-muted-foreground">{sub}</p>
    </div>
  ))}

</div>

<script>
  // ── Easing + reduced-motion ──────────────────────────────────────────
  const rm  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const dur = (ms) => rm ? 0 : ms;
  const easeOutQuart  = (t) => 1 - Math.pow(1 - t, 4);

  // Shared rAF runner. Calls onTick(easedT, rawT) each frame, onDone when complete.
  function animate(duration, easeFn, onTick, onDone) {
    if (duration === 0) { onDone(); return; }
    const start = performance.now();
    (function tick(now) {
      const t = Math.min((now - start) / duration, 1);
      onTick(easeFn(t), t);
      if (t < 1) requestAnimationFrame(tick);
      else onDone();
    })(performance.now());
  }

  // ── Per-card init functions ──────────────────────────────────────────

  function initCounter(card) {
    const el     = card.querySelector('[data-stat="value"]');
    const target = Number(card.dataset.target);
    const suffix = card.dataset.suffix || '';
    card._play = () => {
      el.textContent = '0';
      animate(dur(1600), easeOutQuart,
        (e) => { el.textContent = Math.floor(e * target).toLocaleString() + suffix; },
        ()  => { el.textContent = target.toLocaleString() + suffix; }
      );
    };
  }

  function initDonut(card) {
    const arc    = card.querySelector('[data-stat="arc"]');
    const label  = card.querySelector('[data-stat="label"]');
    const target = Number(card.dataset.target);
    const circ   = Number(card.dataset.circ);
    card._play = () => {
      arc.setAttribute('stroke-dashoffset', circ);
      label.textContent = '0%';
      animate(dur(1400), easeOutQuart,
        (e) => {
          arc.setAttribute('stroke-dashoffset', (circ * (1 - e * target / 100)).toFixed(2));
          label.textContent = Math.floor(e * target) + '%';
        },
        () => {
          arc.setAttribute('stroke-dashoffset', (circ * (1 - target / 100)).toFixed(2));
          label.textContent = target + '%';
        }
      );
    };
  }

  // ── Wire up all cards ────────────────────────────────────────────────
  const inits = {
    counter: initCounter,
    donut:   initDonut,
  };

  document.querySelectorAll('[data-card]').forEach(card => {
    inits[card.dataset.card]?.(card);
  });

  // ── IntersectionObserver — fires play() on scroll into view ─────────
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target._play?.();
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('[data-card]').forEach(card => {
    observer.observe(card);
    card.addEventListener('mouseenter', () => card._play?.());
  });
</script>
