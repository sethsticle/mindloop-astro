---
interface Props {
  src: string;
  class?: string;
}
const { src, class: className = '' } = Astro.props;
---
<video
  data-hls-src={src}
  class={className}
  autoplay
  muted
  loop
  playsinline
></video>

<script>
  import Hls from 'hls.js';

  document.querySelectorAll<HTMLVideoElement>('video[data-hls-src]').forEach((video) => {
    const src = video.dataset.hlsSrc!;
    if (Hls.isSupported()) {
      const hls = new Hls();
      hls.loadSource(src);
      hls.attachMedia(video);
    } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = src;
    }
  });
</script>
