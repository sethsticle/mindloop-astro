---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import FooterV2 from '../components/FooterV2.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Mindloop', description = 'A newsletter and content platform for meaningful ideas.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Navbar />
    <slot />
    <FooterV2 />
    <script src="/scripts/reveal.js" defer></script>
    <script src="/scripts/video-lazy.js" defer></script>
    <script src="/scripts/video-fade.js" defer></script>
  </body>
</html>
