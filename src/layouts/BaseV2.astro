---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import FooterV2 from '../components/FooterV2.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'MLD Marketing Solutions', description = 'Helping ambitious brands break free from the ordinary and reach new heights.' } = Astro.props;

// Cloudflare Web Analytics beacon. The token is a public identifier (it ships in
// page source), so it is inlined rather than kept as a secret. Loaded on
// production builds only - omitted under `astro dev` to keep local runs quiet.
const cfBeaconToken = import.meta.env.PROD ? "a5103a08489b4ed0bdd9be5837541a63" : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <Navbar />
    <slot />
    <FooterV2 /> <!-- New footer with updated design and content -->
    <script src="/scripts/reveal.js" defer></script>
    <script src="/scripts/video-lazy.js" defer></script>
    <script src="/scripts/video-fade.js" defer></script>
    {cfBeaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      />
    )}
  </body>
</html>
