---
import Base from '../layouts/BaseV2.astro';

const pillars = [
  {
    year: '2024',
    heading: 'The Foundation.',
    body: 'We proved the model. Independent writers earning a living wage through direct reader relationships. No middlemen, no algorithms dictating reach. The economics of depth turned out to be more resilient than anyone expected.',
  },
  {
    year: '2025',
    heading: 'The Infrastructure.',
    body: 'We built the pipes. Open publishing APIs, cross-platform distribution, a reading experience that works everywhere from low-bandwidth mobile to desktop. The platform became invisible - the ideas became visible.',
  },
  {
    year: '2026',
    heading: 'The Community.',
    body: 'We\'re here now. Writers and readers converging into something rarer: a genuine intellectual community. Not a social network. Not a forum. A place where thinking out loud is the point.',
  },
  {
    year: '2027+',
    heading: 'The Movement.',
    body: 'What comes next is written by the people who show up. We\'re building infrastructure for a quieter internet - the tools, the standards, the norms. The goal was never Mindloop. The goal was what Mindloop makes possible.',
  },
];

const beliefs = [
  'Depth is not a niche - it is a market the algorithm abandoned.',
  'The best content business aligns writer incentives with reader experience.',
  'Open infrastructure beats proprietary lock-in over any meaningful time horizon.',
  'Slow media is not dead media - it is medicine.',
];
---
<Base title="Vision - Mindloop" description="The future we're building toward. A quieter, deeper internet for people who still believe ideas matter.">

  <!-- Hero -->
  <section class="min-h-[70vh] flex flex-col justify-end pt-44 pb-20 px-8 md:px-28 max-w-6xl mx-auto">
    <p data-reveal class="text-xs tracking-[3px] uppercase text-muted-foreground mb-8">Our Vision</p>
    <h1 data-reveal data-delay="0.05" class="text-6xl md:text-8xl font-medium tracking-[-2px] leading-[1.05] max-w-4xl">
      The future<br /><span class="font-serif italic font-normal">we're building.</span>
    </h1>
    <p data-reveal data-delay="0.15" class="text-xl text-muted-foreground mt-10 max-w-2xl leading-relaxed">
      Not a roadmap. A direction. We don't know exactly where this ends - we know what we're building toward. A quieter internet. A sustainable one. One where ideas move on their own merit.
    </p>
  </section>

  <!-- Timeline -->
  <section class="py-24 md:py-32 border-t border-border/30 px-8 md:px-28 max-w-6xl mx-auto">
    <div class="space-y-0 divide-y divide-border/20">
      {pillars.map(({ year, heading, body }, i) => (
        <div data-reveal data-delay={String(0.05 * i)} class="grid md:grid-cols-12 gap-8 py-14 md:py-20 group">
          <span class="md:col-span-2 text-sm text-muted-foreground font-mono tracking-wide pt-1">{year}</span>
          <div class="md:col-span-10 md:grid md:grid-cols-2 md:gap-12">
            <h3 class="text-3xl md:text-4xl font-medium tracking-[-0.5px] mb-4 md:mb-0">{heading}</h3>
            <p class="text-muted-foreground leading-relaxed">{body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- We believe -->
  <section class="py-24 md:py-32 border-t border-border/30 px-8 md:px-28 max-w-6xl mx-auto">
    <p data-reveal class="text-xs tracking-[3px] uppercase text-muted-foreground mb-16">Things we hold true</p>
    <div class="space-y-6">
      {beliefs.map((b, i) => (
        <p data-reveal data-delay={String(0.06 * i)} class="text-2xl md:text-3xl font-medium tracking-[-0.5px] leading-snug text-foreground/80 border-b border-border/20 pb-6">
          {b}
        </p>
      ))}
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="py-24 md:py-32 border-t border-border/30 px-8 md:px-28 text-center">
    <h2 data-reveal class="text-4xl md:text-6xl font-serif italic font-normal max-w-2xl mx-auto leading-tight">
      Come build it with us.
    </h2>
    <p data-reveal data-delay="0.1" class="text-muted-foreground mt-6 max-w-lg mx-auto">
      Whether you read, write, build, or fund - there's a place for you in what we're making.
    </p>
    <div data-reveal data-delay="0.2" class="flex flex-wrap justify-center gap-4 mt-10">
      <a href="/contact" class="bg-foreground text-background rounded-lg px-8 py-3.5 font-semibold text-sm hover:scale-[1.03] active:scale-[0.98] transition-transform inline-block">
        Get in Touch
      </a>
      <a href="/mission" class="liquid-glass rounded-lg px-8 py-3.5 text-foreground font-semibold text-sm hover:scale-[1.03] active:scale-[0.98] transition-transform inline-block">
        Read Our Mission
      </a>
    </div>
  </section>

</Base>
