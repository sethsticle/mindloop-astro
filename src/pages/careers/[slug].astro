---
import Base from '../../layouts/BaseV2.astro';
import ApplicationForm from '../../components/ApplicationForm.astro';
import { getCollection } from 'astro:content';

const DEPARTMENT_LABELS: Record<string, string> = {
  'social-media-content': 'Social Media & Content',
  'paid-media-performance': 'Paid Media & Performance',
  'video-production': 'Video & Production',
  'design-creative': 'Design & Creative',
  'client-services': 'Client Services',
  operations: 'Operations',
};

const LOCATION_LABELS: Record<string, string> = {
  durban: 'Durban, KZN',
  hybrid: 'Hybrid',
  remote: 'Remote',
};

const TYPE_LABELS: Record<string, string> = {
  'full-time': 'Full-time',
  'part-time': 'Part-time',
  contract: 'Contract',
  internship: 'Internship',
};

export async function getStaticPaths() {
  const jobs = await getCollection('jobs');
  return jobs
    .filter(job => job.data.status === 'open')
    .map(job => ({
      params: { slug: job.id },
      props: { job: { slug: job.id, ...job.data } },
    }));
}

interface Props {
  job: {
    slug: string;
    title: string;
    department: string;
    location: string;
    employmentType: string;
    status: string;
    summary: string;
    description: string;
  };
}
const { job } = Astro.props;
---

<Base title={`${job.title} - MLD Marketing Solutions`} description={job.summary}>

  <!-- Back link -->
  <div class="pt-28 md:pt-32 px-6 md:px-16 max-w-5xl mx-auto">
    <a
      href="/careers"
      class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>
      </svg>
      Careers
    </a>
  </div>

  <!-- Title block -->
  <div class="mt-10 px-6 md:px-16 max-w-5xl mx-auto">
    <div class="flex flex-wrap gap-2 mb-5">
      <span class="px-3 py-1 rounded-full border border-border/40 text-xs text-muted-foreground">{DEPARTMENT_LABELS[job.department]}</span>
      <span class="px-3 py-1 rounded-full border border-border/40 text-xs text-muted-foreground">{LOCATION_LABELS[job.location]}</span>
      <span class="px-3 py-1 rounded-full border border-border/40 text-xs text-muted-foreground">{TYPE_LABELS[job.employmentType]}</span>
    </div>
    <h1 data-reveal class="text-4xl md:text-6xl font-medium tracking-[-1.5px] leading-tight max-w-3xl">
      {job.title}
    </h1>
    <p data-reveal data-delay="0.08" class="text-muted-foreground mt-4 text-lg leading-relaxed max-w-2xl">
      {job.summary}
    </p>
  </div>

  <!-- Description -->
  <section class="mt-16 md:mt-20 px-6 md:px-16 max-w-5xl mx-auto">
    <div class="grid md:grid-cols-12 gap-8 md:gap-16">
      <div class="md:col-span-3">
        <p class="text-xs uppercase tracking-[3px] text-muted-foreground md:sticky md:top-28">
          The Role
        </p>
      </div>
      <div data-reveal class="md:col-span-9">
        <p class="text-xl md:text-2xl leading-relaxed text-foreground/80 whitespace-pre-line">
          {job.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Apply -->
  <section class="mt-24 md:mt-32 pb-32 border-t border-border/30 px-6 md:px-16 max-w-5xl mx-auto">
    <div class="pt-16 md:pt-20 flex flex-col md:flex-row md:items-start gap-12">
      <div class="md:w-1/3">
        <p data-reveal class="text-xs tracking-[3px] uppercase text-muted-foreground mb-4">Apply</p>
        <h2 data-reveal data-delay="0.05" class="text-3xl md:text-4xl font-medium tracking-[-0.5px]">
          Ready to<span class="font-serif italic font-normal"> board?</span>
        </h2>
      </div>
      <div class="md:w-2/3 flex justify-start md:justify-end">
        <ApplicationForm preselectSlug={job.slug} />
      </div>
    </div>
  </section>

</Base>
