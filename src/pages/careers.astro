---
import Base from '../layouts/BaseV2.astro';
import CTAV2 from '../components/CTAV2.astro';
import ApplicationForm from '../components/ApplicationForm.astro';
import { getCollection } from 'astro:content';

const DEPARTMENT_LABELS: Record<string, string> = {
  'social-media-content': 'Social Media & Content',
  'paid-media-performance': 'Paid Media & Performance',
  'video-production': 'Video & Production',
  'design-creative': 'Design & Creative',
  'client-services': 'Client Services',
  operations: 'Operations',
};

const LOCATION_LABELS: Record<string, string> = {
  durban: 'Durban, KZN',
  hybrid: 'Hybrid',
  remote: 'Remote',
};

const TYPE_LABELS: Record<string, string> = {
  'full-time': 'Full-time',
  'part-time': 'Part-time',
  contract: 'Contract',
  internship: 'Internship',
};

const openJobs = (await getCollection('jobs'))
  .filter(job => job.data.status === 'open')
  .map(job => ({ slug: job.id, ...job.data }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Careers - MLD Marketing Solutions" description="Join the crew at MLD Marketing Solutions. See our open roles and send a transmission.">

  <!-- Hero -->
  <section class="pt-44 md:pt-56 pb-20 md:pb-28 px-8 md:px-28 max-w-6xl mx-auto">
    <p data-reveal class="text-xs tracking-[3px] uppercase text-muted-foreground mb-8">Careers</p>
    <h1 data-reveal data-delay="0.05" class="text-6xl md:text-8xl font-medium tracking-[-2px] leading-[1.05] max-w-4xl">
      Join the<br /><span class="font-serif italic font-normal">crew.</span>
    </h1>
    <p data-reveal data-delay="0.15" class="text-xl text-muted-foreground mt-10 max-w-2xl leading-relaxed">
      We're a high-performing, in-office crew of marketing specialists helping ambitious brands reach new frontiers. We're not always hiring for every role below, but we're always looking for talent worth making room for.
    </p>
  </section>

  <!-- Open roles -->
  <section id="roles" class="py-16 md:py-20 border-t border-border/30 px-8 md:px-28 max-w-6xl mx-auto">
    <p data-reveal class="text-xs tracking-[3px] uppercase text-muted-foreground mb-10">Open Roles</p>

    {openJobs.length === 0 ? (
      <p data-reveal class="text-muted-foreground text-lg">
        No open roles right now — check back soon, or send a transmission below and we'll keep you in orbit.
      </p>
    ) : (
      <div class="divide-y divide-border/20">
        {openJobs.map(({ slug, title, department, location, employmentType, summary }, i) => (
          <a
            href={`/careers/${slug}`}
            data-reveal
            data-delay={String(0.05 * i)}
            class="group flex flex-col md:flex-row md:items-center justify-between gap-4 py-8 hover:opacity-80 transition-opacity"
          >
            <div>
              <h3 class="text-2xl md:text-3xl font-medium tracking-[-0.5px]">{title}</h3>
              <p class="text-sm text-muted-foreground mt-2">{summary}</p>
              <div class="flex flex-wrap gap-2 mt-4">
                <span class="px-3 py-1 rounded-full border border-border/40 text-xs text-muted-foreground">{DEPARTMENT_LABELS[department]}</span>
                <span class="px-3 py-1 rounded-full border border-border/40 text-xs text-muted-foreground">{LOCATION_LABELS[location]}</span>
                <span class="px-3 py-1 rounded-full border border-border/40 text-xs text-muted-foreground">{TYPE_LABELS[employmentType]}</span>
              </div>
            </div>
            <span class="shrink-0 inline-flex items-center gap-2 text-sm text-foreground group-hover:gap-3 transition-all">
              View role
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    )}
  </section>

  <!-- Application -->
  <CTAV2 noClip>
    <section id="apply" class="py-20 md:py-32 border-t border-border/30 px-8 md:px-28 max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-16">
        <div class="md:col-span-5 flex flex-col justify-center">
          <p data-reveal class="text-xs tracking-[3px] uppercase text-muted-foreground mb-8">Apply</p>
          <h2 data-reveal data-delay="0.05" class="text-4xl md:text-6xl font-medium tracking-[-1.5px] leading-[1.05]">
            Send a<span class="font-serif italic font-normal"> transmission.</span>
          </h2>
          <p data-reveal data-delay="0.1" class="text-lg text-muted-foreground mt-6">
            Pick the role you're after, tell us a bit about yourself, and we'll take it from there.
          </p>
        </div>
        <div class="md:col-span-7 flex items-center justify-end">
          <ApplicationForm />
        </div>
      </div>
    </section>
  </CTAV2>

</Base>
