---
import Base from "../layouts/BaseV2.astro";
import VideoAutoplay from "../components/VideoAutoplay.astro";
import MissionV2 from "../components/MissionV2.astro";
import CTAV2 from "../components/CTAV2.astro";
import StatsGrid from "../components/StatsGrid.astro";

const platforms = [
  {
    name: "ChatGPT",
    desc: "Conversational answers shaping how people learn and decide.",
    svg: `<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>`,
  },
  {
    name: "Perplexity",
    desc: "Synthesized research replacing the traditional ten blue links.",
    svg: `<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>`,
  },
  {
    name: "Google AI",
    desc: "Generative overviews answering before you ever click through.",
    svg: `<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>`,
  },
];

const solutionItems = [
  {
    title: "Curated Feed",
    desc: "Hand-picked writing that respects your time and attention.",
  },
  {
    title: "Writer Tools",
    desc: "Everything makers need to publish, polish and grow.",
  },
  {
    title: "Community",
    desc: "Conversations that turn readers into collaborators.",
  },
  {
    title: "Distribution",
    desc: "Reach that meets your work where it deserves to be.",
  },
];
---

<Base title="MLD Marketing Solutions">
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="relative min-h-screen w-full overflow-hidden">
    <VideoAutoplay
      src="/assets/video/hero.mp4"
      class="absolute inset-0 w-full h-full object-cover z-0"
      eager
      freeze
    />
    <div
      class="absolute bottom-0 w-full h-64 bg-linear-to-t from-background from-10% to-transparent z-[1]"
    >
    </div>

    <div
      class="relative z-10 flex flex-col items-center text-center px-6 pt-28 md:pt-32 pb-32 max-w-5xl mx-auto "
    >
      <div data-reveal class="flex items-center gap-3 mb-8">
        <div class="flex -space-x-2">
          <img
            src="/assets/images/avatar-1.jpg"
            alt=""
            class="w-8 h-8 rounded-full border-2 border-background"
          />
          <img
            src="/assets/images/avatar-2.jpg"
            alt=""
            class="w-8 h-8 rounded-full border-2 border-background"
          />
          <img
            src="/assets/images/avatar-3.jpg"
            alt=""
            class="w-8 h-8 rounded-full border-2 border-background"
          />
        </div>
        <span class="text-muted-foreground text-sm"
          >7,000+ people already subscribed</span
        >
      </div>

      <h1
        data-reveal
        data-delay="0.1"
        class="text-5xl md:text-7xl lg:text-8xl font-medium tracking-[-2px] leading-[1.05]"
      >
        Let's <span class="font-serif italic font-normal">Collaborate</span> on Ideas That Matter
      </h1>

      <p
        data-reveal
        data-delay="0.2"
        class="text-lg mt-8 max-w-2xl py-2"
        style="color: var(--color-hero-subtitle)"
      >
        Join our feed for meaningful updates, news around technology and a
        shared journey toward depth and direction.
      </p>

      <form
        data-reveal
        data-delay="0.3"
        onsubmit="return false"
        class="liquid-glass rounded-full p-2 max-w-lg w-full flex items-center gap-2 mt-10"
      >
        <input
          type="email"
          placeholder="Enter your email"
          class="flex-1 bg-transparent outline-none px-4 py-2 text-foreground placeholder:text-muted-foreground"
        />
        <button
          type="submit"
          class="bg-foreground text-background rounded-full px-8 py-3 text-sm font-semibold tracking-wide hover:scale-[1.03] active:scale-[0.98] transition-transform"
        >
          SUBSCRIBE
        </button>
      </form>
    </div>

  </section>

  <!-- ── Search Changed ────────────────────────────────────────────────── -->
  <section
    class="px-6 md:px-12 pt-52 md:pt-64 pb-6 md:pb-9 text-center max-w-6xl mx-auto "
  >
    <h2
      data-reveal
      class="text-5xl md:text-7xl lg:text-8xl font-medium tracking-[-2px] leading-[1.05]"
    >
      Search has <span class="font-serif italic font-normal">changed.</span> Have
      you?
    </h2>
    <p
      data-reveal
      data-delay="0.1"
      class="text-muted-foreground text-lg max-w-2xl mx-auto mt-8 mb-24"
    >
      The way people discover ideas has shifted. The question is whether your
      voice still reaches them.
    </p>

    <div class="grid md:grid-cols-3 gap-12 md:gap-8 mb-20">
      {
        platforms.map(({ name, desc, svg }, i) => (
          <div
            data-reveal
            data-delay={String(0.1 * i)}
            class="flex flex-col items-center"
          >
            <div class="w-[200px] h-[200px] flex items-center justify-center liquid-glass-animated rounded-3xl">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="48"
                height="48"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={svg}
              />
            </div>
            <h3 class="font-semibold text-base mt-6">{name}</h3>
            <p class="text-muted-foreground text-sm mt-2 max-w-xs">{desc}</p>
          </div>
        ))
      }
    </div>

    <p data-reveal class="text-muted-foreground text-sm">
      If you don't answer the questions, someone else will.
    </p>
  </section>

  <!-- ── Stats ─────────────────────────────────────────────────────────── -->
  <section class="px-6 md:px-12 py-32 md:py-44 max-w-6xl mx-auto text-center">
    <p
      data-reveal
      class="text-xs tracking-[3px] uppercase text-muted-foreground"
    >
      Results
    </p>
    <h2
      data-reveal
      data-delay="0.1"
      class="text-4xl md:text-6xl font-medium tracking-[-1px] mt-6 leading-tight max-w-3xl mx-auto"
    >
      Results that <span class="font-serif italic font-normal">speak</span> for themselves
    </h2>
    <div data-reveal data-delay="0.2" class="mt-16">
      <StatsGrid />
    </div>
  </section>

  <!-- ── Mission V1 (kept as reference, swapped out for MissionV2 below) ──
  <section
    class="pt-0 pb-32 md:pb-44 px-6 md:px-12 max-w-5xl mx-auto text-center"
  >
    <div data-reveal class="flex justify-center">
      <VideoAutoplay
        src="/assets/video/mission.mp4"
        class="w-full max-w-[800px] aspect-square object-cover rounded-3xl"
      />
    </div>
    <p
      data-reveal
      data-delay="0.1"
      class="text-2xl md:text-4xl lg:text-5xl font-medium tracking-[-1px] mt-16 leading-tight"
    >
      <span class="text-muted-foreground"
        >We're building a space where
      </span><span class="text-foreground">curiosity </span><span
        class="text-foreground"
        >meets
      </span><span class="text-foreground">clarity</span><span
        class="text-muted-foreground"
      >
        - where readers find depth, writers find reach and every newsletter
        becomes a conversation worth having.</span
      >
    </p>
    <p
      data-reveal
      data-delay="0.2"
      class="text-xl md:text-2xl lg:text-3xl font-medium mt-10 text-muted-foreground"
    >
      A platform where content, community and insight flow together - with less
      noise, less friction and more meaning for everyone involved.
    </p>
  </section>
  ── Mission V1 end ──────────────────────────────────────────────────── -->

  <!-- ── Mission V2 — sticky scroll carousel ──────────────────────────── -->
  <MissionV2 />

  <!-- ── Solution ──────────────────────────────────────────────────────── -->
  <section
    class="py-32 md:py-44 px-6 md:px-12 border-t border-border/30 max-w-7xl mx-auto"
  >
    <p
      data-reveal
      class="text-xs tracking-[3px] uppercase text-muted-foreground text-center"
    >
      Solution
    </p>
    <h2
      data-reveal
      data-delay="0.1"
      class="text-4xl md:text-6xl font-medium tracking-[-1px] text-center mt-6 leading-tight max-w-4xl mx-auto"
    >
      The platform for <span class="font-serif italic font-normal"
        >meaningful</span
      > content
    </h2>

    <!-- Solution V1 (kept as reference)
    <div data-reveal data-delay="0.2" class="my-12">
      <VideoAutoplay
        src="/assets/video/solution.mp4"
        class="aspect-[3/1] object-cover rounded-2xl w-full"
      />
    </div>
    Solution V1 end -->

    <!-- Solution V2 — static image with edge gradient fade -->
    <div data-reveal data-delay="0.2" class="relative my-12 rounded-2xl overflow-hidden">
      <img
        src="/assets/images/solution.webp"
        alt="GoHighLevel connecting social media platforms — a unified solution for client growth"
        class="w-full aspect-[2/1] object-cover rounded-2xl"
        loading="lazy"
      />
      <!-- Edge fades — blends the image into the dark page background -->
      <div class="absolute inset-0 rounded-2xl pointer-events-none" style="background: linear-gradient(to right, #000 0%, transparent 12%, transparent 88%, #000 100%);"></div>
      <div class="absolute inset-0 rounded-2xl pointer-events-none" style="background: linear-gradient(to bottom, #000 0%, transparent 15%, transparent 80%, #000 100%);"></div>
    </div>

    <div class="grid md:grid-cols-4 gap-8">
      {
        solutionItems.map(({ title, desc }, i) => (
          <div data-reveal data-delay={String(0.05 * i)}>
            <h3 class="font-semibold text-base">{title}</h3>
            <p class="text-muted-foreground text-sm mt-2">{desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── CTA V1 (kept as reference) ──────────────────────────────────────
  <WavyBackground class="border-t border-border/30 py-32 md:py-44">
    <div class="flex flex-col items-center text-center px-6 max-w-3xl mx-auto">
      <Logo className="w-10 h-10" />
      ...
    </div>
  </WavyBackground>
  CTA V1 end ──────────────────────────────────────────────────────────── -->

  <!-- ── CTA V2 — star-field + comet canvas, no logo ───────────────────── -->
  <CTAV2 class="border-t border-border/30 py-32 md:py-44">
    <div class="flex flex-col items-center text-center px-6 max-w-3xl mx-auto">
      <h2
        data-reveal
        data-delay="0.1"
        class="font-serif italic text-5xl md:text-6xl leading-tight"
      >
        Start Your Journey
      </h2>
      <p
        data-reveal
        data-delay="0.2"
        class="text-muted-foreground text-lg mt-6 max-w-xl"
      >
        Subscribe to read or step in to write. Either way, it begins with a
        single, deliberate move.
      </p>
      <div
        data-reveal
        data-delay="0.3"
        class="flex flex-wrap justify-center gap-4 mt-10"
      >
        <button
          class="bg-foreground text-background rounded-lg px-8 py-3.5 font-semibold text-sm hover:scale-[1.03] active:scale-[0.98] transition-transform"
        >
          Subscribe Now
        </button>
        <button
          class="liquid-glass rounded-lg px-8 py-3.5 text-foreground font-semibold text-sm hover:scale-[1.03] active:scale-[0.98] transition-transform"
        >
          Start Writing
        </button>
      </div>
    </div>
  </CTAV2>
</Base>
