---
import Base from '../layouts/Base.astro';

const cards = [
  {
    title: 'Absolute Independence.',
    desc: 'No algorithms dictating what you read. No ads demanding your attention.',
    span: '',
    svg: `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>`,
  },
  {
    title: 'Quality over Quantity.',
    desc: 'We intentionally throttle the firehose. Slower consumption, deeper understanding.',
    span: '',
    svg: `<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>`,
  },
  {
    title: 'A sustainable ecosystem.',
    desc: 'When writers are paid directly by readers, the incentive is quality, not clickbait. We align the economics with the intellect.',
    span: 'md:col-span-2 md:h-[300px]',
    svg: `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>`,
  },
];
---
<Base title="About - Mindloop" description="A small collective building a quieter, deeper internet. Meet the people behind Mindloop.">

  <section class="pt-44 md:pt-56 pb-20 md:pb-32 px-6 text-center max-w-4xl mx-auto">
    <h1 data-reveal class="text-6xl md:text-8xl font-medium tracking-[-2px] leading-[1.05]">
      Built for the<span class="font-serif italic font-normal"> curious.</span>
    </h1>
    <p data-reveal data-delay="0.1" class="text-xl text-muted-foreground mt-8 leading-relaxed">
      We are a small collective of engineers, writers, and designers who believe the internet needs less noise and a lot more signal. Mindloop is our answer.
    </p>
  </section>

  <section class="py-20 md:py-32 border-t border-border/30">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-6xl mx-auto px-8">
      {cards.map(({ title, desc, span, svg }, i) => (
        <div
          data-reveal
          data-delay={String(0.05 * i)}
          class={`liquid-glass rounded-3xl p-10 md:p-16 flex flex-col justify-between aspect-square md:aspect-auto md:h-[400px] ${span}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground mb-8" set:html={svg} />
          <div>
            <h3 class="text-2xl md:text-3xl font-medium tracking-[-0.5px]">{title}</h3>
            <p class="text-muted-foreground mt-3 max-w-xl">{desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

</Base>
