---
import BaseV2 from '../layouts/BaseV2.astro';
import ParallaxPlants from '../components/ParallaxPlants.astro';
import TeamCard from '../components/TeamCard.astro';

const cards = [
  {
    title: 'Organic First.',
    desc: 'The strongest growth comes from building a lasting presence, not just buying attention. Organic marketing sits at the core of our mission.',
    span: '',
    svg: `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>`,
  },
  {
    title: 'Strategy Meets Creativity.',
    desc: 'We combine strategy, creativity, and cutting-edge digital solutions to launch brands into new markets and accelerate growth.',
    span: '',
    svg: `<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>`,
  },
  {
    title: 'Global Crew, Local Results.',
    desc: 'From a one-person mission to a crew of more than 20 specialists reaching across the globe - we\'ve become a recognised force in the marketing universe, and we\'re only just beginning the next phase of our journey.',
    span: 'md:col-span-2 md:h-[300px]',
    svg: `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>`,
  },
];

const principles = [
  {
    number: '01',
    title: 'Organic over rented.',
    body: 'We believe the strongest growth comes from building a lasting presence, not just buying attention. More than 85% of our clients\' marketing success is driven by organic growth strategies - attracting the right audience, building genuine trust, and establishing authority within their industry.',
  },
  {
    number: '02',
    title: 'Strategy, creativity, technology.',
    body: 'We combine strategy, creativity, and cutting-edge digital solutions to launch brands into new markets, accelerate growth, and create lasting impact. Every solution we build is designed to move our clients closer to their goals.',
  },
  {
    number: '03',
    title: 'Results, not just reach.',
    body: 'We navigate challenges, embrace opportunities, and commit ourselves to delivering exceptional results for every client we encounter. The mission remains the same: helping ambitious brands reach new frontiers.',
  },
];

const plants = [
  { src: '/assets/images/plant-3.webp',    style: 'top: -8vh; right: -10vw; width: 42vw; opacity: 0.11; rotate: 12deg; z-index: 0;',   speed: 0.1,  blur: 0  },
  { src: '/assets/images/plant-5-tall.webp',style: 'top: 8vh; right: -2vw; height: 130vh; width: auto; opacity: 0.2; rotate: 4deg; z-index: 1;', speed: 0.22, blur: 0  },
  { src: '/assets/images/plant-1.webp',    style: 'top: 62vh; left: -8vw; width: 30vw; opacity: 0.17; rotate: -16deg; z-index: 1;',    speed: 0.25, blur: 0  },
  { src: '/assets/images/plant-6.webp',    style: 'top: 38vh; right: 2vw; width: 22vw; opacity: 0.3; rotate: -9deg; z-index: 2;',      speed: 0.4,  blur: 2  },
  { src: '/assets/images/plant-2.webp',    style: 'top: 82vh; left: 1vw; width: 24vw; opacity: 0.28; rotate: 11deg; z-index: 2;',      speed: 0.42, blur: 2  },
  { src: '/assets/images/plant-4.webp',    style: 'top: 42vh; left: -14vw; width: 34vw; opacity: 0.48; rotate: 24deg; z-index: 10;',   speed: 0.65, blur: 6  },
  { src: '/assets/images/plant-1.webp',    style: 'top: 68vh; right: -14vw; width: 38vw; opacity: 0.55; rotate: -30deg; z-index: 11;', speed: 0.82, blur: 10 },
];

const team = [
  { image: '/assets/images/sasha-card-text-removed.webp', name: 'Sasha Dolby'   },
  { image: '/assets/images/mike-card-text-removed.webp',  name: 'Michael Dolby' },
];
---

<BaseV2 title="Our Mission - MLD Marketing Solutions" description="At MLD Marketing Solutions, we help ambitious brands break free from the ordinary and reach new heights.">

  <ParallaxPlants plants={plants} />

  <div class="relative" style="z-index: 5;">

    <!-- ── Hero ───────────────────────────────────────────────────────── -->
    <section class="pt-44 md:pt-56 pb-20 md:pb-32 px-6 text-center max-w-4xl mx-auto">
      <p data-reveal class="text-xs tracking-[3px] uppercase text-muted-foreground mb-8">Our Mission</p>
      <h1 data-reveal data-delay="0.05" class="text-6xl md:text-8xl font-medium tracking-[-2px] leading-[1.05]">
        Break free from the<span class="font-serif italic font-normal"> ordinary.</span>
      </h1>
      <p data-reveal data-delay="0.1" class="text-xl text-muted-foreground mt-8 leading-relaxed">
        At MLD Marketing Solutions, we help ambitious brands break free from the ordinary and reach new heights. What began nearly a decade ago as a one-person mission has grown into a globally recognised marketing agency powered by a talented crew of specialists.
      </p>
    </section>

    <!-- ── Cards ─────────────────────────────────────────────────────── -->
    <section class="py-20 md:py-32 border-t border-border/30">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-6xl mx-auto px-8">
        {cards.map(({ title, desc, span, svg }, i) => (
          <div
            data-reveal
            data-delay={String(0.05 * i)}
            class={`liquid-glass rounded-3xl p-10 md:p-16 flex flex-col justify-between aspect-square md:aspect-auto md:h-[400px] ${span}`}
          >
            <!-- decorative brand-colour wash, clipped to the card by liquid-glass's own overflow:hidden -->
            <div class="pointer-events-none absolute -top-20 -left-20 h-72 w-72 rounded-full opacity-25 blur-3xl" style="background: var(--color-brand-yellow)"></div>
            <div class="pointer-events-none absolute -bottom-20 -right-20 h-72 w-72 rounded-full opacity-25 blur-3xl" style="background: var(--color-brand-teal)"></div>

            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="46" height="46"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.55"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="relative text-muted-foreground mb-8"
              set:html={svg}
            />
            <div class="relative">
              <h3 class="text-2xl md:text-3xl font-medium tracking-[-0.5px]">{title}</h3>
              <p class="text-muted-foreground mt-3 max-w-xl">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Mission ───────────────────────────────────────────────────── -->
    <section class="pt-24 md:pt-32 border-t border-border/30 px-8 md:px-28 max-w-6xl mx-auto">
      <p data-reveal class="text-xs tracking-[3px] uppercase text-muted-foreground mb-8">Why We Exist</p>
      <h2 data-reveal data-delay="0.05" class="text-5xl md:text-7xl font-medium tracking-[-2px] leading-[1.05] max-w-4xl">
        We exist to help brands<br /><span class="font-serif italic font-normal">reach new heights.</span>
      </h2>
      <p data-reveal data-delay="0.15" class="text-xl text-muted-foreground mt-10 max-w-2xl leading-relaxed">
        As our mission continues to expand, one thing remains constant: our commitment to helping businesses navigate the ever-changing digital universe and achieve extraordinary results.
      </p>
    </section>

    <!-- ── Principles ────────────────────────────────────────────────── -->
    <section class="py-24 md:py-32 border-t border-border/30 mt-16 px-8 md:px-28 max-w-6xl mx-auto">
      <p data-reveal class="text-xs tracking-[3px] uppercase text-muted-foreground mb-16">What we believe</p>
      <div class="space-y-0 divide-y divide-border/20">
        {principles.map(({ number, title, body }, i) => (
          <div data-reveal data-delay={String(0.05 * i)} class="grid md:grid-cols-12 gap-8 py-12 md:py-16">
            <span class="md:col-span-1 text-sm text-muted-foreground font-mono pt-1">{number}</span>
            <div class="md:col-span-4">
              <h3 class="text-2xl md:text-3xl font-medium tracking-[-0.5px]">{title}</h3>
            </div>
            <p class="md:col-span-6 text-muted-foreground leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Team ──────────────────────────────────────────────────────── -->
    <section class="py-24 md:py-32 border-t border-border/30 px-8 ">
      <p data-reveal class="text-xs tracking-[3px] uppercase text-muted-foreground mb-16 text-center">Mission Crew</p>
      <div class="flex flex-col sm:flex-row justify-center items-start gap-22 max-w-4xl mx-auto">
        {team.map(({ image, name }, i) => (
          <TeamCard
            data-reveal
            data-delay={String(0.05 * i)}
            image={image}
            name={name}
            class="w-full sm:w-1/2 "
          />
        ))}
      </div>
    </section>

    <!-- ── Pull quote ─────────────────────────────────────────────────── -->
    <section class="py-24 md:py-32 border-t border-border/30 px-8 md:px-28 text-center">
      <blockquote data-reveal class="text-3xl md:text-5xl lg:text-6xl font-serif italic font-normal max-w-4xl mx-auto leading-tight text-foreground/90">
        "The mission remains the same: helping ambitious brands reach new frontiers."
      </blockquote>
      <p data-reveal data-delay="0.1" class="mt-8 text-muted-foreground text-sm tracking-wide">— MLD Marketing Solutions</p>
    </section>

  </div>

</BaseV2>
