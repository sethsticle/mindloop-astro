---
import Base from '../layouts/BaseV2.astro';
import CTAV2 from '../components/CTAV2.astro';
import { Image } from 'astro:assets';
import tetheredAstronaut from '../assets/images/tethered-astronaut.png';

const details = [
  { label: 'Michael Dolby', value: 'michael@mldmarketing.co.za', href: 'mailto:michael@mldmarketing.co.za' },
  { label: 'Lara',          value: 'lara@mldmarketing.co.za',    href: 'mailto:lara@mldmarketing.co.za' },
  { label: 'Call / WhatsApp', value: '071 939 7108',             href: 'https://wa.me/27719397108' },
];

const inputCls = 'bg-transparent border-b border-border/50 text-foreground placeholder:text-muted-foreground focus:outline-none focus:border-foreground transition-colors py-3 w-full mb-8';
---

<Base title="Open a Transmission - MLD Marketing Solutions" description="Have a question, a brand ready to launch, or just want to say hello? Get in touch with MLD Marketing Solutions.">

  <!-- CTAV2 provides the star-field + comet canvas as a full-page background -->
  <CTAV2 noClip class="min-h-screen">

    <section class="min-h-[90vh] flex items-center pt-32 pb-20 px-8 md:px-28 relative">

      <!--
        Tethered astronaut — positioned absolute so the body sits in the lower-left
        and the tether arcs diagonally up and to the right, disappearing behind the form card.
        drop-shadow lifts the dark tether rope off the black page background.
        z-index: 1 keeps it behind the text (z-2) and form card (z-3).
      -->
      <Image
        src={tetheredAstronaut}
        width={1600}
        format="webp"
        alt=""
        aria-hidden="true"
        class="hidden md:block absolute pointer-events-none select-none"
        style="
          bottom: -20%;
          left: -6%;
          width: 78%;
          z-index: 1;
          opacity: 0.92;
          filter: drop-shadow(0 0 12px rgba(255,255,255,0.12)) drop-shadow(0 0 4px rgba(180,210,255,0.18));
        "
      />

      <!-- Grid — z-2 so text sits above astronaut; form card bumped to z-3 -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-16 w-full relative" style="z-index: 2;">

        <!-- Left — text content -->
        <div class="md:col-span-5 flex flex-col justify-center">
          <p data-reveal class="text-xs tracking-[3px] uppercase text-muted-foreground mb-8">Open a Transmission</p>
          <h1 data-reveal data-delay="0.05" class="text-6xl md:text-8xl font-medium tracking-[-2px] leading-[1.05]">
            Board the<span class="font-serif italic font-normal"> Mothership.</span>
          </h1>
          <p data-reveal data-delay="0.1" class="text-lg text-muted-foreground mt-6 mb-12">
            Have a question, a brand ready to launch, or just want to say hello? Send a transmission our way.
          </p>
          <div class="space-y-4">
            {details.map(({ label, value, href }, i) => (
              <div data-reveal data-delay={String(0.15 + i * 0.05)} class="flex gap-4 items-center">
                <span class="text-sm text-muted-foreground w-40">{label}</span>
                <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined} class="text-base font-medium hover:text-muted-foreground transition-colors">{value}</a>
              </div>
            ))}
          </div>
        </div>

        <!-- Right — form card sits in front of the tether -->
        <div class="md:col-span-7 flex items-center justify-end" style="z-index: 3; position: relative;">
          <form
            data-reveal
            data-delay="0.2"
            data-enquiry-form
            class="liquid-glass rounded-3xl p-8 md:p-12 w-full max-w-lg"
          >
            <input type="hidden" name="kind" value="contact" />
            <!-- Honeypot - hidden from real users, bots tend to fill every field -->
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <input type="text"   name="name"    placeholder="Your Name"       required class={inputCls} />
            <input type="email"  name="email"   placeholder="Email Address"   required class={inputCls} />
            <textarea rows={4}   name="message" placeholder="Tell us about your mission" required class={inputCls}></textarea>
            <button
              type="submit"
              class="w-full bg-foreground text-background rounded-full py-4 font-medium hover:scale-[1.02] transition-transform"
            >
              Send Transmission
            </button>
            <p data-enquiry-status class="hidden mt-4 text-sm text-muted-foreground" role="status"></p>
          </form>
        </div>

      </div>
    </section>

  </CTAV2>

  <script is:inline src="/scripts/enquiry-form.js"></script>

  <!-- Pull quote — creates natural breathing room above the footer -->
  <section class="py-24 md:py-32 border-t border-border/30 px-8 md:px-28 text-center">
    <blockquote data-reveal class="text-3xl md:text-5xl lg:text-6xl font-serif italic font-normal max-w-4xl mx-auto leading-tight text-foreground/90">
      "Helping ambitious brands reach new frontiers."
    </blockquote>
    <p data-reveal data-delay="0.1" class="mt-8 text-muted-foreground text-sm tracking-wide">— MLD Marketing Solutions</p>
  </section>

</Base>
