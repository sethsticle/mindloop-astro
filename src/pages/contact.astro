---
import Base from '../layouts/BaseV2.astro';
import CTAV2 from '../components/CTAV2.astro';

const details = [
  { label: 'General Inquiries', value: 'hello@mindloop.com' },
  { label: 'Press & Media',     value: 'press@mindloop.com' },
  { label: 'Support',           value: 'help@mindloop.com'  },
];

const inputCls = 'bg-transparent border-b border-border/50 text-foreground placeholder:text-muted-foreground focus:outline-none focus:border-foreground transition-colors py-3 w-full mb-8';
---

<Base title="Contact - Mindloop" description="Have a question, partnership idea, or just want to say hello? Get in touch with the Mindloop team.">

  <!-- CTAV2 provides the star-field + comet canvas as a full-page background -->
  <CTAV2 noClip class="min-h-screen">

    <section class="min-h-[90vh] flex items-center pt-32 pb-20 px-8 md:px-28 relative">

      <!--
        Tethered astronaut — positioned absolute so the body sits in the lower-left
        and the tether arcs diagonally up and to the right, disappearing behind the form card.
        drop-shadow lifts the dark tether rope off the black page background.
        z-index: 1 keeps it behind the text (z-2) and form card (z-3).
      -->
      <img
        src="/assets/images/tethered-astronaut.png"
        alt=""
        aria-hidden="true"
        class="hidden md:block absolute pointer-events-none select-none"
        style="
          bottom: -20%;
          left: -6%;
          width: 78%;
          z-index: 1;
          opacity: 0.92;
          filter: drop-shadow(0 0 12px rgba(255,255,255,0.12)) drop-shadow(0 0 4px rgba(180,210,255,0.18));
        "
      />

      <!-- Grid — z-2 so text sits above astronaut; form card bumped to z-3 -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-16 w-full relative" style="z-index: 2;">

        <!-- Left — text content -->
        <div class="md:col-span-5 flex flex-col justify-center">
          <h1 data-reveal class="text-6xl md:text-8xl font-medium tracking-[-2px] leading-[1.05]">
            Let's<span class="font-serif italic font-normal"> connect.</span>
          </h1>
          <p data-reveal data-delay="0.1" class="text-lg text-muted-foreground mt-6 mb-12">
            Have a question, partnership idea, or just want to say hello? Drop us a line.
          </p>
          <div class="space-y-4">
            {details.map(({ label, value }, i) => (
              <div data-reveal data-delay={String(0.15 + i * 0.05)} class="flex gap-4 items-center">
                <span class="text-sm text-muted-foreground w-40">{label}</span>
                <a href={`mailto:${value}`} class="text-base font-medium hover:text-muted-foreground transition-colors">{value}</a>
              </div>
            ))}
          </div>
        </div>

        <!-- Right — form card sits in front of the tether -->
        <div class="md:col-span-7 flex items-center justify-end" style="z-index: 3; position: relative;">
          <form
            data-reveal
            data-delay="0.2"
            onsubmit="return false"
            class="liquid-glass rounded-3xl p-8 md:p-12 w-full max-w-lg"
          >
            <input type="text"   placeholder="Your Name"       class={inputCls} />
            <input type="email"  placeholder="Email Address"   class={inputCls} />
            <textarea rows={4}   placeholder="How can we help?" class={inputCls}></textarea>
            <button
              type="submit"
              class="w-full bg-foreground text-background rounded-full py-4 font-medium hover:scale-[1.02] transition-transform"
            >
              Send Message
            </button>
          </form>
        </div>

      </div>
    </section>

  </CTAV2>

  <!-- Pull quote — creates natural breathing room above the footer -->
  <section class="py-24 md:py-32 border-t border-border/30 px-8 md:px-28 text-center">
    <blockquote data-reveal class="text-3xl md:text-5xl lg:text-6xl font-serif italic font-normal max-w-4xl mx-auto leading-tight text-foreground/90">
      "Every great collaboration starts with a single message."
    </blockquote>
    <p data-reveal data-delay="0.1" class="mt-8 text-muted-foreground text-sm tracking-wide">— MLD Marketing Solutions</p>
  </section>

</Base>
