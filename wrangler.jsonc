{
	// LOCAL DEV + TYPE GENERATION ONLY. Production deploy uses dist/server/wrangler.json (generated by adapter at build time).
	// Run: npm run deploy  ->  astro build && wrangler deploy --config ./dist/server/wrangler.json
	"compatibility_date": "2026-05-20",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "mindloop-astro", // CONFIGURE: set to your CF Worker name (becomes subdomain on workers.dev)
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// CONFIGURE: run `wrangler d1 create mindloop-astro-legends` once, then paste
	// the returned database_id below. Holds Local Legends vote rows only (votes
	// table, migrations/0001_votes.sql) - everything else on the site is static
	// content via Keystatic. Apply the migration with:
	//   wrangler d1 execute mindloop-astro-legends --local --file=./migrations/0001_votes.sql
	//   wrangler d1 execute mindloop-astro-legends --remote --file=./migrations/0001_votes.sql
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mindloop-astro-legends",
			"database_id": "0b810c96-d21e-4677-9459-2cf0b3e29dc3"
		}
	],
	// CONFIGURE: Cloudflare Turnstile site key (public, not a secret - safe to
	// commit). Create a Turnstile widget at dash.cloudflare.com/?to=/:account/turnstile,
	// paste the site key here and the secret key via `wrangler secret put TURNSTILE_SECRET_KEY`.
	"vars": {
		"PUBLIC_TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY"
	}
}